# coldaisle 環境変数の雛形
#
# 使い方: cp .env.example .env して .env 側に値を書く。.env は git 管理外。
# このファイルには値を書かないこと（変数名のみ）。
#
# **`.env` は自動では読まれません。** `uv run --env-file .env ...` で渡すか、
# `export UV_ENV_FILE=.env` してください。渡し忘れるとエラーにはならず、
# 「未設定」として静かに動きます（LLM なら「利用不可」、通知なら stdout だけ）。
#
# 現時点で仕様上確定している変数だけを記載しています。
# LLM 関連の追加変数は #21 で追記します。

# LLM Provider（OpenAI 互換 API）
# Ollama <-> vLLM の切替はこの 2 つだけで行う（要件 FR-501 / §7.2）
OPENAI_BASE_URL=
MODEL_NAME=

# --------------------------------------------------------------------------
# Claude API（ローカル LLM が入るまでの間だけの代わり。決定記録 0143 / #324）
#
# **COLDAISLE_LLM_PROVIDER=anthropic と明示したときだけ使います。** 鍵を置いただけでは
# 外へ送りません（空・未設定なら上の OpenAI 互換のまま）。
# 送るのは集計値だけ（日次レポートの表・アラートの Evidence・Server Health の固定の文）。
# 1 日の回数と 1 回の長さの上限は config/ai.yaml の anthropic: にあります。
# ローカル LLM が入ったら COLDAISLE_LLM_PROVIDER と ANTHROPIC_API_KEY を消してください
# （戻す手順は docs/llm-setup.md）。
#
# COLDAISLE_LLM_PROVIDER  openai_compatible（既定） / anthropic
# ANTHROPIC_API_KEY       Claude API の鍵。**ここ（.env.example）には書かない**
# ANTHROPIC_MODEL         モデル ID。推奨: claude-haiku-5-5（質が足りなければ claude-sonnet-5-5）
# ANTHROPIC_WORKSPACE_ID  任意。ワークスペースに属さない鍵で API が anthropic-workspace-id を
#                         求める（400）ときだけ書く。空白を含めない。空なら送らない
COLDAISLE_LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_WORKSPACE_ID=

# --------------------------------------------------------------------------
# 通知（#20 / 決定記録 0013）
#
# 未設定の宛先は作られず、その重大度は残りの宛先（stdout）にだけ届きます。
# 足りないことは起動時に警告が出ます（黙って無効にはしません）。
# 実際に届くかの確かめ方は docs/notifications.md（#51）。

# Slack: 監視専用チャンネルの Incoming Webhook
COLDAISLE_SLACK_WEBHOOK=

# LINE: Messaging API のチャネルアクセストークンと送信先 ID
# （LINE Notify は2025年に終了しているため Messaging API を使う）
COLDAISLE_LINE_TOKEN=
COLDAISLE_LINE_TO=

# 通知の本文の最後に付けるダッシュボードのリンク（#307）。
# 空なら config/notify.yaml の dashboard_url（サーバー自身から見た 127.0.0.1）を使う。
# Slack を別の端末で開いて押せるアドレスにする。http / https の絶対 URL でホストを含むこと。
# 形が不正なら daemon / report / escalate は起動時に落ちる。
# 例（仮の値）: https://dashboard.example.invalid/
COLDAISLE_DASHBOARD_URL=

# --------------------------------------------------------------------------
# API（#9 / 決定記録 0009 §2.9）。既定値で動くので、変えるときだけ設定します。

# COLDAISLE_DB=var/coldaisle.db
# COLDAISLE_METRICS=config/metrics.yaml
# COLDAISLE_MAX_POINTS=2000
