# ロールアップと保持期間の適用（#10 / 決定記録 0008 §2.7）のテンプレート。
#
# 1回走って終わる。起動は coldaisle-rollup.timer が行う。
# 取り込みデーモンの中では動かさない（0008 §2.7）。WAL なので取り込みと並行してよい。

[Unit]
Description=coldaisle rollup and retention

[Service]
Type=oneshot
User=coldaisle
Group=coldaisle
WorkingDirectory=/opt/coldaisle
StateDirectory=coldaisle
# 2770（setgid）: coldaisle-fand も補助グループ coldaisle で DB を書く。どの unit の起動でも
# 同じ mode に戻るので、/var/lib/coldaisle を使う unit すべてで揃える（決定記録 0080 §2.1）
StateDirectoryMode=2770
# SQLite の -wal / -journal を DB と同じグループで書けるようにする（0080 §2.1）
UMask=0007
ExecStart=/opt/coldaisle/.venv/bin/coldaisle-rollup --db /var/lib/coldaisle/coldaisle.db

StandardOutput=journal
StandardError=journal
SyslogIdentifier=coldaisle-rollup

NoNewPrivileges=yes
PrivateTmp=yes
